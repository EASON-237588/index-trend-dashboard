//@version=6
// 期貨趨勢・台指傳送（2026-10-21，連續月）
// 使用者定：台指訊號與資料一律以 TradingView 為準、一律連續月。
// 掛在台指期大台（TAIFEX:TXF1!）30 秒圖（10/21 使用者要求台指一律用大台），圖表要開「依合約變更調整」（右下角 B-ADJ 亮起）。
// 每根 30 秒 K 收盤送一則警報到轉接站 tw：最新 3 根（漏送一次下一則會補）＋一段補歷史
// （每次 40 根，從 4,800 根前往現在補，約 60 分鐘一輪，補完再從頭循環）。
// 換約時 TradingView 會把舊 K 棒整段平移；循環補送會把轉接站裡的舊 K 棒以時間覆蓋成平移後的價格，所以存下來的一律是連續月。
// 警報設定：條件選這支腳本的「任何 alert() 函式呼叫」，通知只勾「網址」，
// 網址填 https://index-trend-tx.eason-237588.workers.dev/tw/push?k=密碼（密碼同台指那一組，在 worker-tx\.dev.vars）。
// 一分鐘兩次，在 TradingView 對太頻繁觸發的警報自動停用的門檻內。
// 刻意只有最後一行有縮排：用程式塞進 TradingView 編輯器時，縮排會一行一行疊加亂掉。
indicator("台指傳送", overlay = true, max_bars_back = 4800)
var int back = 4800
ok = barstate.isrealtime and barstate.isconfirmed
f(k) => "[" + str.tostring(math.floor(time[k] / 1000)) + "," + str.tostring(open[k]) + "," + str.tostring(high[k]) + "," + str.tostring(low[k]) + "," + str.tostring(close[k]) + "," + str.tostring(nz(volume[k])) + "]"
g(k, lo) => k >= lo ? "," + f(k) : ""
top = math.min(4800, bar_index)
hi = math.min(back, top)
lo = math.max(hi - 39, 3)
s1 = f(0) + "," + f(1) + "," + f(2) + g(hi, lo) + g(hi - 1, lo) + g(hi - 2, lo) + g(hi - 3, lo) + g(hi - 4, lo) + g(hi - 5, lo) + g(hi - 6, lo) + g(hi - 7, lo) + g(hi - 8, lo) + g(hi - 9, lo)
s2 = g(hi - 10, lo) + g(hi - 11, lo) + g(hi - 12, lo) + g(hi - 13, lo) + g(hi - 14, lo) + g(hi - 15, lo) + g(hi - 16, lo) + g(hi - 17, lo) + g(hi - 18, lo) + g(hi - 19, lo)
s3 = g(hi - 20, lo) + g(hi - 21, lo) + g(hi - 22, lo) + g(hi - 23, lo) + g(hi - 24, lo) + g(hi - 25, lo) + g(hi - 26, lo) + g(hi - 27, lo) + g(hi - 28, lo) + g(hi - 29, lo)
s4 = g(hi - 30, lo) + g(hi - 31, lo) + g(hi - 32, lo) + g(hi - 33, lo) + g(hi - 34, lo) + g(hi - 35, lo) + g(hi - 36, lo) + g(hi - 37, lo) + g(hi - 38, lo) + g(hi - 39, lo)
back := ok ? (hi >= lo and lo - 1 > 3 ? lo - 1 : top) : back
if ok
    alert("{\"s\":\"" + syminfo.ticker + "\",\"b\":[" + s1 + s2 + s3 + s4 + "]}", alert.freq_all)
